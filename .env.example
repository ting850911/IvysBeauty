DATABASE_URL=
PII_ENCRYPTION_KEY=
CLOUDINARY_URL=

# 專案基礎網址（用於 OAuth Callback 驗證）
NEXT_PUBLIC_APP_URL=

# --- AWS Cognito 設定 ---
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Issuer 格式通常是: https://cognito-idp.<你的Region>.amazonaws.com/<你的UserPoolID>
COGNITO_ISSUER=
# Cognito 託管的 Domain (結尾沒有 /)
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=

# --- LINE Login 設定 (如果你也要一起準備) ---
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=
